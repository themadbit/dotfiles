status is-interactive; or return

# git
alias gca 'git commit --amend'
alias gcb 'git checkout -b'
alias gcm 'git commit -m'
alias gco 'git checkout'
alias grb 'git rebase'
alias grba 'git rebase --abort'
alias grbc 'git rebase --continue'
alias gst 'git status'
alias lg lazygit

# ls
alias l 'ls -alh'
alias ll 'ls -l'
alias ls 'ls --color=tty'

# navigation
alias src 'cd ~/src'
alias nixpkgs 'cd ~/src/nixpkgs/'
alias ngipkgs 'cd ~/src/ngipkgs/'

# scripts (github.com/themadbit/scripts, cloned to ~/src/scripts)
alias gitconfig '~/src/scripts/git-config.sh'
alias tshconfig '~/src/scripts/teleport.sh'
alias quote '~/src/scripts/quote.sh'
